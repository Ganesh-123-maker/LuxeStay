<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-10 offset-1">
    <h3>Admin — Listings</h3>
    <% for (const l of listings) { %>
      <div class="card mb-3"><div class="card-body">
        <h5><a href="/listings/<%= l._id %>"><%= l.title %></a></h5>
        <p class="mb-2"><%= l.location %>, <%= l.country %> · Owner: <%= l.owner ? l.owner.username : "—" %> · ₹<%= l.price.toLocaleString("en-IN") %></p>
        <form action="/admin/listings/<%= l._id %>/delete" method="POST" class="d-inline"><button class="btn btn-sm btn-danger">Delete listing</button></form>
      </div></div>
    <% } %>
    <% if (listings.length === 0) { %><p class="text-muted">No listings yet.</p><% } %>
  </div>
</div>
