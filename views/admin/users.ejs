<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-10 offset-1">
    <h3>Admin — Users</h3>
    <table class="table">
      <thead><tr><th>Username</th><th>Email</th><th>Role</th><th>Created</th></tr></thead>
      <tbody>
        <% for (const u of users) { %>
          <tr><td><%= u.username %></td><td><%= u.email %></td><td><%= u.role %></td><td><%= u.createdAt ? u.createdAt.toISOString().slice(0,10) : "" %></td></tr>
        <% } %>
      </tbody>
    </table>
    <% if (users.length === 0) { %><p class="text-muted">No users yet.</p><% } %>
  </div>
</div>
