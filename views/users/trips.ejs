<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3>My Trips</h3>
    <% if (bookings.length === 0) { %>
      <p class="text-muted mt-3">No trips yet. <a href="/listings">Browse listings</a> to book your first stay.</p>
    <% } %>
    <% for (const b of bookings) { %>
      <div class="card mb-3">
        <div class="card-body">
          <h5><a href="/listings/<%= b.listing ? b.listing._id : "" %>"><%= b.listing ? b.listing.title : "Listing removed" %></a></h5>
          <p class="mb-1"><%= b.checkIn.toISOString().slice(0,10) %> → <%= b.checkOut.toISOString().slice(0,10) %> · <%= b.nights %> night(s) · <%= b.guests %> guest(s)</p>
          <p class="mb-1">Total (incl. 18% GST): ₹<%= b.totalPrice.toLocaleString("en-IN") %></p>
          <p class="mb-2">Status: <b><%= b.status %></b> · Payment: <%= b.paymentStatus %><% if (b.paymentStatus === "demo") { %> <span class="badge-demo">Demo mode — no real payment taken</span><% } %></p>
          <% if (["pending", "confirmed"].includes(b.status)) { %>
            <form action="/bookings/<%= b._id %>/cancel" method="POST" class="d-inline"><button class="btn btn-sm btn-outline-danger">Cancel booking</button></form>
          <% } %>
          <% if (b.status === "pending") { %>
            <form action="/bookings/<%= b._id %>/pay" method="POST" class="d-inline"><button class="btn btn-sm btn-dark">Pay (Stripe test, or Demo if keys missing)</button></form>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>
